# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only (never expose): used for public share-link file downloads and the LINE OA worker
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The deployed URL, e.g. https://hoose-app.vercel.app (used in share links and login emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Phase 2 · HOOSE Official LINE OA (Messaging API) — not used yet
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
