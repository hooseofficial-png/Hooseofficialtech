# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only (never expose): used for public share-link file downloads and the LINE OA worker
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The deployed URL, e.g. https://hoose-app.vercel.app (used in share links and login emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# HOOSE Official LINE OA (Messaging API) · webhook https://app.hooseofficial.site/api/line/webhook
# LINE Developers → Basic settings → Channel secret · Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# LINE AI assistant (Claude Console → API Keys). Model defaults to claude-haiku-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Google Calendar API (Google Cloud → APIs & Services → Credentials → OAuth client ID, type "Web application")
# Authorized redirect URI: https://app.hooseofficial.site/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outgoing e-mail (invites) via HOOSE's SMTP, e.g. Gmail: smtp.gmail.com / 465 / hooseofficial@gmail.com / App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HOOSE <hooseofficial@gmail.com>
# Show "Continue with Google" on the login page once Supabase → Auth → Providers → Google is enabled
NEXT_PUBLIC_GOOGLE_LOGIN=
# LINE Login channel (same provider as the OA) + LIFF app for the application form (/line/apply)
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=
# ClickUp (editing work): personal API token from ClickUp → Settings → Apps; list ids (comma-separated)
CLICKUP_API_TOKEN=
CLICKUP_LIST_IDS=901805543973
# Vercel Cron auth for /api/cron/editing-reminders (any long random string)
CRON_SECRET=
# LINE OA add-friend link for the editor home button (optional)
NEXT_PUBLIC_LINE_OA_URL=
