# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only (never expose): used for public share-link file downloads and the LINE OA worker
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The deployed URL, e.g. https://hoose-app.vercel.app (used in share links and login emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Phase 2 · HOOSE Official LINE OA (Messaging API) — not used yet
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Google Calendar API (Google Cloud → APIs & Services → Credentials → OAuth client ID, type "Web application")
# Authorized redirect URI: https://app.hooseofficial.site/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outgoing e-mail (invites) via HOOSE's SMTP, e.g. Gmail: smtp.gmail.com / 465 / hooseofficial@gmail.com / App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HOOSE <hooseofficial@gmail.com>
# Show "Continue with Google" on the login page once Supabase → Auth → Providers → Google is enabled
NEXT_PUBLIC_GOOGLE_LOGIN=
